[
  {
    "start": 0.0,
    "end": 30.0,
    "text": "卫队４卫队４卫队�卫队�卫队�"
  },
  {
    "start": 30.0,
    "end": 30.96,
    "text": "我们有试做了"
  },
  {
    "start": 33.44,
    "end": 34.84,
    "text": "如果在地球另一侧"
  },
  {
    "start": 35.44,
    "end": 36.76,
    "text": "也落下一个苹果呢"
  },
  {
    "start": 37.96,
    "end": 39.68,
    "text": "他们都朝着地球的中心"
  },
  {
    "start": 41.76,
    "end": 43.12,
    "text": "地球在吸引着他们"
  },
  {
    "start": 44.36,
    "end": 46.32,
    "text": "如果这种吸引能延伸的更远"
  },
  {
    "start": 46.84,
    "end": 49.08,
    "text": "那么月亮会不会同样受到他的作用"
  },
  {
    "start": 50.88,
    "end": 51.36,
    "text": "对了"
  },
  {
    "start": 51.92,
    "end": 53.84,
    "text": "月球为什么不会和地球相撞"
  },
  {
    "start": 56.56,
    "end": 57.32,
    "text": "先看看"
  },
  {
    "start": 57.8,
    "end": 59.36,
    "text": "一件东西能怎样下落"
  },
  {
    "start": 60.0,
    "end": 61.48,
    "text": "现在做一个想象实验"
  },
  {
    "start": 61.68,
    "end": 63.08,
    "text": "暂时没有空气阻力"
  },
  {
    "start": 63.28,
    "end": 65.2,
    "text": "从高处让小球衡着处罚"
  },
  {
    "start": 67.24,
    "end": 68.32,
    "text": "他向前运动"
  },
  {
    "start": 68.88,
    "end": 70.08,
    "text": "同时也在下落"
  },
  {
    "start": 70.68,
    "end": 71.76,
    "text": "他飞得更远了"
  },
  {
    "start": 72.04,
    "end": 73.2,
    "text": "还是落到了地面"
  },
  {
    "start": 75.64,
    "end": 76.92,
    "text": "他为什么总向下落"
  },
  {
    "start": 77.08,
    "end": 78.24,
    "text": "我们回到同一期点"
  },
  {
    "start": 78.44,
    "end": 79.72,
    "text": "再增加向前的速度"
  },
  {
    "start": 81.4,
    "end": 81.96,
    "text": "看他"
  },
  {
    "start": 82.32,
    "end": 83.32,
    "text": "他还在下落"
  },
  {
    "start": 83.68,
    "end": 85.08,
    "text": "却一直绕过了地面"
  },
  {
    "start": 85.96,
    "end": 87.8,
    "text": "月亮原本也在向前运动"
  },
  {
    "start": 88.4,
    "end": 89.4,
    "text": "地球的心意"
  },
  {
    "start": 89.4,
    "end": 91.2,
    "text": "不断改变着她的方向"
  },
  {
    "start": 91.52,
    "end": 92.92,
    "text": "苹果离我们这么近"
  },
  {
    "start": 93.32,
    "end": 94.52,
    "text": "月亮却远得多"
  },
  {
    "start": 95.32,
    "end": 96.4,
    "text": "相隔这么远"
  },
  {
    "start": 96.6,
    "end": 98.08,
    "text": "吸引还会一样强吗"
  },
  {
    "start": 110.2,
    "end": 111.2,
    "text": "距离越远"
  },
  {
    "start": 111.4,
    "end": 112.48,
    "text": "吸引越弱"
  },
  {
    "start": 112.96,
    "end": 114.4,
    "text": "但究竟怎样减弱"
  },
  {
    "start": 114.6,
    "end": 115.92,
    "text": "要与精确减弱去"
  },
  {
    "start": 115.92,
    "end": 117.24,
    "text": "原来的四分之一"
  },
  {
    "start": 119.4,
    "end": 123.4,
    "text": "这一次 预测与记录稳合了"
  },
  {
    "start": 123.4,
    "end": 126.4,
    "text": "地上的苹果 天上的月亮"
  },
  {
    "start": 126.4,
    "end": 129.4,
    "text": "原来能用同一种吸引来解释"
  },
  {
    "start": 130.4,
    "end": 133.4,
    "text": "这种吸引也不是单项的"
  },
  {
    "start": 133.4,
    "end": 137.4,
    "text": "地球吸引苹果 苹果也吸引地球"
  },
  {
    "start": 137.4,
    "end": 138.4,
    "text": "只是地球太大"
  },
  {
    "start": 138.4,
    "end": 141.4,
    "text": "它的运动变化很难被察觉"
  },
  {
    "start": 142.4,
    "end": 144.4,
    "text": "如果这是一条共同的规律"
  },
  {
    "start": 144.4,
    "end": 146.4,
    "text": "就要继续谨言"
  },
  {
    "start": 146.4,
    "end": 147.4,
    "text": "它能否解释更多运"
  },
  {
    "start": 147.4,
    "end": 148.68,
    "text": "又是更多运动"
  },
  {
    "start": 148.68,
    "end": 151.08,
    "text": "凝果留下了一个问题"
  },
  {
    "start": 151.08,
    "end": 154.64,
    "text": "许多次思考 推言与何对"
  },
  {
    "start": 154.64,
    "end": 156.0,
    "text": "让地上的运动"
  },
  {
    "start": 156.0,
    "end": 158.08,
    "text": "与天上的运动联系起来"
  }
]